# syntax=docker/dockerfile:1
ARG BASE_IMAGE=debian:trixie
FROM ${BASE_IMAGE} AS prerequisites
ARG DISTRO
ENV DEBIAN_FRONTEND=noninteractive
# The base images normally delete apt's downloaded packages after installation.
RUN rm -f /etc/apt/apt.conf.d/docker-clean
RUN --mount=type=cache,id=apt-packages-${DISTRO},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-lists-${DISTRO},target=/var/lib/apt/lists,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends make python3 python3-venv
WORKDIR /project

FROM prerequisites AS test
ARG EXPECTED_PYTHON
COPY --link Makefile pyproject.toml ./
COPY --link src/ ./src/
COPY --link scripts/ ./scripts/
COPY --link tests/ ./tests/
COPY --link ci/assert-runtime.py ci/test_offline_install.py ./ci/
COPY --link offline/cpython-${EXPECTED_PYTHON}-linux-x86_64/ ./offline/cpython-${EXPECTED_PYTHON}-linux-x86_64/
RUN --network=none python3 ci/assert-runtime.py "${EXPECTED_PYTHON}" && python3 -B ci/test_offline_install.py

# Online build tools are isolated from the runtime-only test stage above.
FROM prerequisites AS upgrade-tools
RUN --mount=type=cache,id=apt-packages-${DISTRO},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-lists-${DISTRO},target=/var/lib/apt/lists,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates build-essential python3-dev libpcsclite-dev swig binutils

FROM prerequisites AS resolver-tools
RUN --mount=type=cache,id=apt-packages-${DISTRO},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-lists-${DISTRO},target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends ca-certificates
RUN python3 -m venv /tools && /tools/bin/python -m pip install --upgrade packaging

FROM resolver-tools AS upgrade-tests
COPY --link scripts/refresh_pins.py ./scripts/refresh_pins.py
COPY --link ci/tests/ ./ci/tests/
RUN --network=none /tools/bin/python -I -B -m unittest discover -s ci/tests -v

FROM resolver-tools AS refresh-pins
ARG SUPPORTED_PYTHONS
COPY --link pyproject.toml ./
COPY --link scripts/refresh_pins.py ./scripts/refresh_pins.py
RUN /tools/bin/python scripts/refresh_pins.py --pythons "${SUPPORTED_PYTHONS}" --output /export/pyproject.toml

FROM scratch AS pins-export
COPY --from=refresh-pins /export/ /

FROM upgrade-tools AS upgrade
ARG EXPECTED_PYTHON
COPY --link pyproject.toml Makefile ./
COPY --link src/ ./src/
COPY --link scripts/ ./scripts/
COPY --link tests/ ./tests/
RUN python3 scripts/offline.py build --upgrade && \
    mkdir -p /export/offline && \
    cp -a offline/cpython-${EXPECTED_PYTHON}-linux-x86_64 /export/offline/

FROM scratch AS bundle-export
COPY --from=upgrade /export/ /

FROM python:3.14-slim AS lint-tools
RUN pip install --no-cache-dir ruff==0.17.2
WORKDIR /project

FROM lint-tools AS lint
COPY --link pyproject.toml ./
COPY --link src/ ./src/
COPY --link scripts/ ./scripts/
COPY --link tests/ ./tests/
COPY --link ci/ ./ci/
RUN --network=none ruff check --no-cache src scripts tests ci && \
    ruff format --check --no-cache src scripts tests ci

# Pin both the checker and its JavaScript runtime.
FROM node:24.19.0-bookworm-slim AS pyright-node
RUN npm install --global pyright@1.1.414

FROM resolver-tools AS typecheck
COPY --from=pyright-node /usr/local/bin/node /usr/local/bin/node
COPY --from=pyright-node /usr/local/lib/node_modules/pyright /opt/pyright
COPY --link pyproject.toml ./
# Only library sources/types are needed; do not compile the optional PCSC backend.
RUN /tools/bin/python -c 'import subprocess, tomllib; p=tomllib.load(open("pyproject.toml", "rb")); subprocess.run(["/tools/bin/python", "-m", "pip", "install", "--no-deps", *p["project"]["dependencies"]], check=True)' 
COPY --link src/ ./src/
COPY --link scripts/ ./scripts/
COPY --link tests/ ./tests/
COPY --link ci/ ./ci/
RUN --network=none node /opt/pyright/index.js --pythonpath /tools/bin/python
